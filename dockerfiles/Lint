ARG OS_VERSION=latest

FROM alpine:${OS_VERSION}

ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY requirements-lint.txt collections.yml /tmp/

# The collections let ansible-lint --offline resolve the FQCNs the roles use
RUN apk --no-cache add bash curl git python3 py3-pip shellcheck \
    && pip3 install --no-compile -r /tmp/requirements-lint.txt \
    && ansible-galaxy collection install -r /tmp/collections.yml -p /usr/share/ansible/collections \
    && rm -rf /tmp/requirements-lint.txt /tmp/collections.yml /root/.ansible /root/.cache \
    && find /usr/lib/python3* -name '__pycache__' -type d -prune -exec rm -rf {} +

CMD ["/bin/bash"]
